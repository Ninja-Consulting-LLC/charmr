# Server Configuration
PORT=3001
NODE_ENV=staging

# Database Configuration
DB_PATH=:memory:

# API Keys
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=OPENAI_API_KEY_REDACTED
OPENAI_SANDBOX_MODE=false

GEMINI_MODEL=gemini-1.5-pro
GEMINI_API_KEY=GOOGLE_API_KEY_REDACTED
GEMINI_SANDBOX_MODE=false

# Model Configuration
MAX_TOKENS=1000
TEMPERATURE=0.7
GEMINI_MAX_TOKENS=1000
GEMINI_TEMPERATURE=0.7

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=*

# Message Limits
PRO_DAILY_MESSAGE_LIMIT=200

# Email Configuration (Development)
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SENDGRID_API_KEY_REDACTED
EMAIL_SECURE=false
EMAIL_DEFAULT_FROM=noreply@example.invalid
EMAIL_DEFAULT_REPLY_TO=support@example.invalid

# Security
ADMIN_TOKEN=admin_secret