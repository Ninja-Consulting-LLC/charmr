# Server Configuration
PORT=3001
NODE_ENV=staging

# Database Configuration (SQLite local / staging)
DB_PATH=:memory:

# API Keys — use real values only in your private .env (never commit)
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_SANDBOX_MODE=false

GEMINI_MODEL=gemini-1.5-pro
GEMINI_API_KEY=
GEMINI_SANDBOX_MODE=false

# Model Configuration
MAX_TOKENS=1000
TEMPERATURE=0.7
GEMINI_MAX_TOKENS=1000
GEMINI_TEMPERATURE=0.7

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=*

# Message Limits
PRO_DAILY_MESSAGE_LIMIT=200

# SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@charmr.app
SMTP_REPLY_TO=support@charmr.app
SUPPORT_EMAIL=support@charmrapp.com

# Security — set in dashboard / private env only
ADMIN_TOKEN=

# Admin: comma-separated emails allowed for POST /api/admin/reset-db (required in production)
CHARMR_RESET_DB_ALLOWLIST=
