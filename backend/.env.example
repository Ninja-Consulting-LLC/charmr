# Server Configuration
NODE_ENV=development
PORT=3001

# OpenAI Configuration
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=gpt-4-vision-preview
OPENAI_SANDBOX_MODE=false
MAX_TOKENS=1000
TEMPERATURE=0.7  # Controls response creativity (0.0-1.0)

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes in milliseconds
RATE_LIMIT_MAX_REQUESTS=100  # Maximum requests per window

# Security
CORS_ORIGIN=*

# Email Configuration
EMAIL_HOST=mailhog
EMAIL_PORT=1025
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_DEFAULT_FROM=noreply@example.invalid
EMAIL_DEFAULT_REPLY_TO=support@example.invalid

# SES SMTP aliases (optional)
# If EMAIL_* values are unset, backend falls back to these keys.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=support@example.invalid
