# Server Configuration
NODE_ENV=development
PORT=3001

# OpenAI Configuration (primary path for /api/generate-reply)
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=gpt-4-vision-preview
OPENAI_SANDBOX_MODE=false
MAX_TOKENS=1000
TEMPERATURE=0.7  # Controls response creativity (0.0-1.0)

# Gemini — required in production alongside OpenAI (config validation). Selecting gemini via AI_SERVICE
# does not yet provide full parity with the OpenAI vision/chat path; see services/geminiService.ts.
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-pro-vision
AI_SERVICE=openai

# Production only: allow AI_SERVICE=gemini despite incomplete parity (default: blocked in production).
# CHARMR_ALLOW_GEMINI_IN_PRODUCTION=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes in milliseconds
RATE_LIMIT_MAX_REQUESTS=100  # Maximum requests per window

# Security
CORS_ORIGIN=*

# Comma-separated emails allowed for POST /api/admin/reset-db (Firebase token `email`).
# Production: set in Render/hosting (see render.yaml). Unset in dev = any admin JWT may reset (still risky—set explicitly if you want).
CHARMR_RESET_DB_ALLOWLIST=

# Local dev / Maestro: match routes may use URL :userId without matching auth header (never enable in production).
CHARMR_DEV_INSECURE_MATCH_USER_ID=1

# E2E / Maestro (optional — local API)
# CHARMR_E2E_STUB_LLM=true          # stub /api/generate-reply (use with npm run test:e2e:stub-llm)
# CHARMR_E2E_FORCE_MESSAGE_LIMIT=true  # always 429 MESSAGE_LIMIT (do not combine with stub)

# SMTP Configuration
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@charmr.app
SMTP_REPLY_TO=support@charmrapp.com
