# Used for local API + Simulator (`127.0.0.1`). Build: ENVFILE=.env.e2e npx react-native run-ios …
#
# Image picker: **false** = real iOS Photos UI (Screenshots album + patch). This is the default for dev.
# `npm run test:e2e` builds with a **temporary** env that sets RELAX **true** only for that build (stub/02 + flow `28`).
CHARMR_E2E_RELAX_IMAGE_PICKER=false
API_BASE_URL=http://127.0.0.1:3001
LOCAL_IP=127.0.0.1
REVENUECAT_IOS_API_KEY=appl_UMgrSaoNRlkZizjzuPOBcPLEGzh
REVENUECAT_ANDROID_API_KEY=your_android_key_here
CHAT_PAGE_SIZE=20
LOGGER_DEBUG_LEVEL=true
LOGGER_INFO_LEVEL=true
LOGGER_WARN_LEVEL=true
LOGGER_ERROR_LEVEL=true
