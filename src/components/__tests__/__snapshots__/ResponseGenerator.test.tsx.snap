              "flexDirection": "row",
              "gap": 8,
              "justifyContent": "flex-end",
              "marginTop": 16,
            }
          }
        >
          <Button
            mode="outlined"
            onPress={[Function]}
            testID="cancel-button"
          >
            Cancel
          </Button>
          <Button
            mode="contained"
            onPress={[Function]}
            testID="add-button"
          >
            Add
          </Button>
        </View>
      </View>
    </Modal>
  </View>
</RNCSafeAreaProvider>
`;
