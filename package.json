{
  "name": "ai-dating-keyboard",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "postinstall": "patch-package",
    "android": "react-native run-android",
    "ios": "react-native run-ios --simulator 'iPhone 16 Pro Max'",
    "ios:device": "react-native run-ios --device 'Ninja phone'",
    "ios:clean": "rm -rf ios/Pods ios/Podfile.lock && cd ios && pod deintegrate && pod install && cd ..",
    "lint": "eslint .",
    "start": "react-native start",
    "test:backend": "ts-node src/test/backend.integration.test.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "clean": "rm -rf node_modules && npm install",
    "reset": "npm run clean && npm start -- --reset-cache",
    "install:fast": "npm ci --no-audit --no-fund --prefer-offline",
    "update-deps": "npx npm-check-updates -u && npm install",
    "firebase:deploy": "firebase deploy",
    "firebase:deploy:rules": "firebase deploy --only firestore:rules",
    "firebase:deploy:indexes": "firebase deploy --only firestore:indexes",
    "firebase:deploy:functions": "firebase deploy --only functions",
    "docker:up": "cd backend &&COMPOSE_BAKE=true docker-compose up -d --build",
    "delete-db": "rm -f backend/data/charmr.db",
    "generate-icons": "app-icon generate --icon assets/logo-solidbg.png",
    "prepare": "npx husky",
    "pre-commit": "cd backend && npm test"
  },
  "dependencies": {
    "@invertase/react-native-apple-authentication": "^2.4.1",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@react-native-camera-roll/camera-roll": "^7.10.0",
    "@react-native-clipboard/clipboard": "^1.16.2",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-firebase/app": "^21.14.0",
    "@react-native-firebase/auth": "^21.14.0",
    "@react-native-firebase/installations": "^21.14.0",
    "@react-native-firebase/messaging": "^21.14.0",
    "@react-native-google-signin/google-signin": "^13.2.0",
    "@react-navigation/native": "^7.1.6",
    "@react-navigation/native-stack": "^7.3.10",
    "@types/react-native-onboarding-swiper": "^1.1.9",
    "axios": "^1.8.4",
    "patch-package": "^8.0.0",
    "postinstall-postinstall": "^2.1.0",
    "react": "19.0.0",
    "react-native": "^0.79.1",
    "react-native-config": "^1.5.5",
    "react-native-fbsdk-next": "^12.1.0",
    "react-native-gifted-chat": "^2.8.1",
    "react-native-image-crop-picker": "^0.42.0",
    "react-native-keyboard-controller": "^1.17.1",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-logs": "^5.3.0",
    "react-native-onboarding-swiper": "^1.3.0",
    "react-native-paper": "^5.13.2",
    "react-native-purchases": "8.9.6",
    "react-native-purchases-ui": "8.9.6",
    "react-native-reanimated": "^3.17.4",
    "react-native-safe-area-context": "^5.4.0",
    "react-native-screens": "^4.10.0",
    "react-native-sha256": "^1.4.10",
    "react-native-vector-icons": "^10.2.0",
    "regenerator-runtime": "^0.14.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.27.0",
    "@react-native-community/cli": "^18.0.0",
    "@react-native-community/cli-platform-android": "^18.0.0",
    "@react-native-community/cli-platform-ios": "^18.0.0",
    "@react-native/babel-preset": "0.79.1",
    "@react-native/eslint-config": "0.79.1",
    "@react-native/metro-config": "0.79.1",
    "@react-native/typescript-config": "0.79.1",
    "@testing-library/react-native": "^12.4.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "19.0.0",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/react-test-renderer": "19.0.0",
    "app-icon": "^0.13.2",
    "cors": "^2.8.5",
    "eslint": "^9.0.0",
    "express": "^5.1.0",
    "firebase-tools": "^13.0.0",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "jsdom": "^26.1.0",
    "lint-staged": "^15.2.2",
    "node-fetch": "^3.3.2",
    "prettier": "2.8.8",
    "react-native-dotenv": "^3.4.11",
    "react-test-renderer": "19.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=22"
  },
  "lint-staged": {
    "backend/**/*.{js,ts}": [
      "cd backend && npm test"
    ]
  }
}
