# Manual QA: **real** iOS Photos picker (no bundled image inject). Same API keys as `.env.e2e` otherwise.
#
# Build & install (pick one):
#   npm run ios:e2e-manual
#   npm run ios:e2e-manual -- --device "Your iPhone Name"
#   npm run ios:e2e-manual -- --simulator "iPhone 16 Pro Max"
#
# Physical device + backend on your Mac: set API_BASE_URL to the Mac's LAN IP (not 127.0.0.1), e.g.
#   API_BASE_URL=http://192.168.1.42:3001
# Then rebuild. Simulator can keep http://127.0.0.1:3001.
#
# Take at least one screenshot first so the Screenshots album is non-empty (`useImagePicker` targets it).
CHARMR_E2E_RELAX_IMAGE_PICKER=false
API_BASE_URL=http://127.0.0.1:3001
LOCAL_IP=127.0.0.1
REVENUECAT_IOS_API_KEY=appl_UMgrSaoNRlkZizjzuPOBcPLEGzh
REVENUECAT_ANDROID_API_KEY=your_android_key_here
CHAT_PAGE_SIZE=20
LOGGER_DEBUG_LEVEL=true
LOGGER_INFO_LEVEL=true
LOGGER_WARN_LEVEL=true
LOGGER_ERROR_LEVEL=true
